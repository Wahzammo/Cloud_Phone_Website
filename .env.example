# North Metro Portal - Environment Variables Template
# Copy this file to .env and customize for your environment

# Z220 Server IP Address
SERVER_IP=192.168.1.220

# Redroid ADB Ports (default: 5555-5558)
REDROID_1_PORT=5555
REDROID_2_PORT=5556
REDROID_3_PORT=5557
REDROID_4_PORT=5558

# WS-SCRCPY Web Ports (default: 8000-8003)
SCRCPY_1_PORT=8000
SCRCPY_2_PORT=8001
SCRCPY_3_PORT=8002
SCRCPY_4_PORT=8003

# Frontend Port (default: 3000)
FRONTEND_PORT=3000

# Cloudflare Tunnel (if used)
# CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# Tailscale (if used)
# TAILSCALE_AUTH_KEY=your_auth_key_here
